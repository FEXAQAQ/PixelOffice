# =============================================================
#  PixelOffice — 環境變數設定範例
#  複製此檔為 .env 後填入實際值：  cp .env.example .env
#  （用 start.bat / start.command 啟動時，沒有 .env 會自動幫你複製一份）
# =============================================================

# ---------- 伺服器 ----------
PORT=3000

# 綁定位址。預設 127.0.0.1（只有本機連得到）。
# 這個服務沒有任何認證，而且能指定任意路徑執行 claude，
# 所以除非你已自行加上認證與網路隔離，不要改成 0.0.0.0。
HOST=127.0.0.1

# ---------- AI 平台 ----------
# 未保存畫面設定時的預設平台。畫面「設定 > AI 平台」保存至 config/ai.json，優先於此值。
AI_PROVIDER=claude
# 全域只有 mock / real 兩種模式。
# mock：Claude、Codex 與 Jira 全部使用模擬資料。
# real：所選 AI 平台執行真實 CLI，Jira 固定使用 Atlassian MCP。
PIXEL_OFFICE_MODE=mock
# AI 權限：ask（要求核准）/ auto（代我核准）/ full（完整存取）
AI_ACCESS_MODE=auto
CODEX_BIN=codex
# 選用：啟用「檢查成果 → Jev 小助手」。從 TypeSafe 控制台取得；只在手動按「開始檢查」時呼叫 API。
# Jev 小助手是選配模組，預設關閉；可在「設定 → 功能模組」切換，或在這裡設 on 當開機預設值
# JEV_ENABLED=on
# TYPESAFE_API_KEY=
# 自訂 AI 平台設定檔位置（測試環境可使用獨立檔案）
# AI_CONFIG=C:/path/to/ai.json

# ---------- Jira 串接 ----------
# Real 模式的 Jira 固定透過 Atlassian Rovo MCP Server。
# 啟用 Real 前請先完成下方 MCP 的一次性 OAuth 授權。

# ---------- 撈單範圍 ----------
# Real 模式必填（Mock 用不到）：Jira 看板數字 ID（看板網址中的 boards/123 或 rapidView=123）。
# 列出此看板所有 active Sprint，依 startDate 降冪選最新一個；同日以 ID 降冪排序。
# 沒有 active Sprint 時回傳空清單，絕不回退到其他 Sprint。
JIRA_BOARD_ID=
# 選用：再限定專案；Sprint 邊界與待辦、未指派條件不受自訂 JQL 覆蓋。
# JIRA_PROJECT=
# 選用：額外篩選條件，例如 priority = High；排序固定為 created DESC。
# JIRA_JQL=

# 設為 true 會在終端機印出 Jira 原始回應，方便比對標題是否與卡面一致
JIRA_DEBUG=false

# PM 開單（辦公室裡點 PM →「開新單」）使用的提示範本。
# 預設讀 config/jira-card-prompt.md；要換一份範本才需要設定這個路徑。
# Real 可建立真實 Jira 工單；Mock 只會模擬，不會寫入 Jira。
# 開單的專案代碼取自 JIRA_PROJECT；沒設定就從 JIRA_BOARD_ID 最新進行中 Sprint 的工單推導。
# 父系下拉要列出哪種議題類型（可用逗號分隔多個）。留空等同預設值「大型工作」。
# 專案裡找不到指定類型時，會退回列出所有非子任務類型。
# JIRA_PARENT_TYPES=大型工作
# JIRA_CARD_PROMPT_FILE=

# ---------- Atlassian MCP（Real 模式）----------
# server.js 會 spawn 下列指令，把 Atlassian 遠端 MCP 服務轉成本地 stdio 來呼叫。
# ⚠️ 首次使用前，請先在終端機手動跑一次以完成 OAuth 授權（會開瀏覽器登入 Atlassian）：
#       npx mcp-remote@latest "https://mcp.atlassian.com/v2/mcp?tools=all"
#    授權成功後 token 會快取在 ~/.mcp-auth，之後 server 即可免互動使用。
#    ⚠️ token 依「URL 的 md5」分目錄存放 —— 改了下面的 JIRA_MCP_URL 就等於換一個
#       未授權的 server，必須用新 URL 重跑一次授權。沒授權完成的症狀是
#       「MCP 請求逾時：initialize」。
#    URL 必須帶 ?tools=all，否則工具清單不含 listJiraBoardSprints。
JIRA_MCP_URL=https://mcp.atlassian.com/v2/mcp?tools=all
# 自訂啟動指令 / 參數（通常不用改）
# JIRA_MCP_COMMAND=npx
# JIRA_MCP_ARGS=-y mcp-remote@latest https://mcp.atlassian.com/v2/mcp?tools=all
# 若已知 cloudId 可直接指定，省去一次查詢（選填）
# JIRA_CLOUD_ID=
# 開單成功後組「在 Jira 開啟」連結用的站台網址（選填，MCP 回應沒帶網址時才會用到）
# JIRA_BASE_URL=https://your-site.atlassian.net

# ---------- Claude Code CLI 執行 ----------
# claude 執行檔路徑或指令名稱（若不在 PATH 內可填絕對路徑）
CLAUDE_BIN=claude

# ---------- 模型 ----------
# 每位工程師用哪個模型，是設定在 config/engineers.json 的 model 欄位（或畫面上的 ⚙ 設定）。
# 留空 = 不加 --model，跟著 claude CLI 自己的預設。
#
# ANTHROPIC_API_KEY 只用來撈「模型清單」（Models API）。沒設也沒差 ——
# 清單會退回別名（opus / sonnet / haiku / fable），那本來就夠用。
# ⚠️ 這個 key 預設「不會」傳進 claude 子程序，所以不會影響 claude 用你的訂閱登入。
# ANTHROPIC_API_KEY=
#
# 真的想讓 claude 改走 API key 計費（而不是你的訂閱）才設 true。
# CLAUDE_USE_API_KEY=false

# ---------- 任務資料夾 / 專案設定 ----------
# 接取的 JIRA 工單會以 JSON 存到此資料夾（工程師從這裡讀單執行）。留空預設為 ./task
TASK_DIR=

# 各專案路徑設定檔（工程師被指派任務時，依此決定要在哪個專案路徑執行）。預設 ./config/projects.json
PROJECTS_CONFIG=

# 工程師名單設定檔（畫面上的 ⚙ 設定 儲存時會寫回這裡）。預設 ./config/engineers.json
ENGINEERS_CONFIG=

# 角色外觀設定檔（畫面上儲存角色設定時會寫回這裡）。預設 ./config/roles.json
ROLES_CONFIG=

# 畫面設定覆寫檔（mock/real、AI 權限、看板 ID、功能模組）。預設 ./config/runtime.json
RUNTIME_CONFIG=

# 驗收後的工作日誌資料夾。預設 ./note
NOTE_DIR=

# 若 config/projects.json 沒設定、或指派時沒選專案，退回使用的預設工作目錄。留空則為本專案目錄。
WORKSPACE_DIR=
